# ИСПОЛЬЗУЕМ СТАБИЛЬНУЮ ЛЕГКОВЕСНУЮ ВЕРСИЮ NODE.JS
FROM node:20-alpine

# Устанавливаем рабочую директорию в контейнере
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь остальной код проекта в контейнер
COPY . .

# Открываем порт для фронтенда (для Next.js/Vite обычно 3000 или 5173, укажем 3000)
EXPOSE 3000

# Запускаем приложение в режиме разработки
CMD ["npm", "run", "dev"]